{
  // Safety floor: no rule may use older_than_days below this value.
  "min_age_days": 1,

  // Maximum posts to delete in one `delete --apply` run (rate limits apply).
  "max_deletes_per_run": 50,

  // Your original posts (not a reply and not a repost).
  "tweets": {
    // Text-only tweets (no photo, video, or GIF attached on the post object).
    "text": {
      "rules": [
        { "older_than_days": 30, "max_likes": 5 },
        { "older_than_days": 365, "max_likes": 50, "max_reposts": 10 }
      ]
    },
    // Tweets with at least one media attachment (photo, video, or GIF).
    "media": {
      "rules": [
        { "older_than_days": 90, "max_likes": 10 }
      ]
    }
  },

  // Replies you posted on someone else's thread.
  "replies": {
    "text": {
      "rules": [
        { "older_than_days": 14, "max_likes": 2 }
      ]
    },
    "media": {
      "rules": [
        { "older_than_days": 30, "max_likes": 5 }
      ]
    }
  },

  // Reposts (retweets). Set to null or use "enabled": false to never delete reposts.
  "reposts": {
    "text": null,
    "media": null
  }
}
