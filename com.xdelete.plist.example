<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xdelete</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/usr/bin/python3 /ABSOLUTE/PATH/TO/x-delete/xdelete.py preview --update-state &amp;&amp; /usr/bin/python3 /ABSOLUTE/PATH/TO/x-delete/xdelete.py delete --apply</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/x-delete/xdelete.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/x-delete/xdelete.log</string>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/x-delete</string>
</dict>
</plist>
